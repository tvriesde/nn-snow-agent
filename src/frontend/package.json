{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@azure/msal-browser": "5.23.0",
    "expo": "55.0.31",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-web": "0.21.2",
    "@expo/metro-runtime": "55.0.12"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "typescript": "5.9.3",
    "tsx": "4.21.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "expo start --web",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "tsx --test tests/helpers.test.ts && node --test tests/server.test.mjs",
    "web": "expo start --web"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "private": true
}
